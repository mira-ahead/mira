{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"dev": "varlock-wrangler dev --port $(varlock printenv SERVER_PORT)",
		"build": "wrangler deploy --dry-run --outdir dist",
		"check-types": "tsc --noEmit",
		"test": "NODE_ENV=test varlock run -- vitest run",
		"deploy": "varlock-wrangler deploy",
		"cf-typegen": "varlock-wrangler types",
		"env:generate": "varlock codegen"
	},
	"dependencies": {
		"@ai-sdk/mistral": "^4.0.89",
		"@clickhouse/client-web": "1.25.0",
		"@langfuse/otel": "^6.1.1",
		"@langfuse/tracing": "^6.1.1",
		"@langfuse/vercel-ai-sdk": "^6.1.1",
		"@opentelemetry/api": "~1.9.1",
		"@opentelemetry/context-async-hooks": "^2.12.1",
		"@opentelemetry/core": "^2.12.1",
		"@opentelemetry/exporter-trace-otlp-http": "^0.223.2",
		"@opentelemetry/otlp-exporter-base": "^0.223.2",
		"@opentelemetry/sdk-trace-base": "^2.12.0",
		"@varlock/cloudflare-integration": "^1.6.4",
		"ai": "catalog:",
		"hono": "catalog:",
		"varlock": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "catalog:",
		"@mira/config": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "^5.1.1",
		"wrangler": "4.166.0"
	}
}
